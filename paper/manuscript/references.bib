%% ------------------------------- Hierarchical consistency (prior art for the
%% ------------------------------- directional consistency objective)
%% HMCN supplies the squared-hinge violation penalty, but its penalty is
%% symmetric in gradient (both operands move) and uses NO label conditioning.
%% HMCN itself credits the max{0,.}^2 form to the order-embedding line
%% (Wehrmann & Barros, CVPR 2018; Wehrmann, Mattjie & Barros, PRL 2018) --
%% those two were NOT independently verified, so do not attribute the form to
%% HMCN as its originator without checking them.
%% PMLR gives pages 5075--5084. A widely mirrored third-party BibTeX gives
%% 5225--5234, which is WRONG. Do not "correct" this back.
@inproceedings{wehrmann2018hmcn,
  author    = {Wehrmann, J{\^o}natas and Cerri, Ricardo and
               Barros, Rodrigo C.},
  title     = {Hierarchical multi-label classification networks},
  booktitle = {Proceedings of the 35th International Conference on Machine
               Learning},
  series    = {Proceedings of Machine Learning Research},
  volume    = {80},
  pages     = {5075--5084},
  year      = {2018},
  publisher = {PMLR}
}

%% The closest relative of our directional rule: its MCLoss multiplies by the
%% binary label INSIDE a max, so the label selects the candidate set and the
%% max selects the gradient recipient. It contains no stop-gradient, enforces
%% consistency architecturally (the max constraint module), and couples outputs
%% along a FIXED taxonomy rather than per-sample label patterns.
@inproceedings{giunchiglia2020chmcnn,
  author    = {Giunchiglia, Eleonora and Lukasiewicz, Thomas},
  title     = {Coherent hierarchical multi-label classification networks},
  booktitle = {Advances in Neural Information Processing Systems},
  volume    = {33},
  pages     = {9662--9673},
  year      = {2020},
  publisher = {Curran Associates, Inc.}
}
